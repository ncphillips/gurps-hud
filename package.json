{
  "name": "gurps-hud",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "harness": "vite --config vite.harness.config.ts",
    "build": "vite build",
    "check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src e2e",
    "format": "prettier --write src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^3.0.0",
    "fvtt-types": "github:League-of-Foundry-Developers/foundry-vtt-types#main",
    "jsdom": "^30.0.1",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^3.3.0",
    "svelte": "^5.55.8",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
